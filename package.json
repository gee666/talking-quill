{
  "name": "talking-quill",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first system-wide dictation for Windows and macOS",
  "author": "Talking Quill contributors",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "pnpm --filter @talking-quill/app build",
    "build:helper": "node scripts/build-helper.mjs",
    "dev": "pnpm --filter @talking-quill/app dev",
    "dev:visible-probe": "node scripts/probe-dev-visible.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 && pnpm boundaries",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @talking-quill/app typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-source-e2e.mjs",
    "test:live:providers": "vitest run tests/live/providers.live.test.ts",
    "test:packaged": "playwright test --project=packaged",
    "test:packaged-media-instrumented": "node scripts/run-instrumented-packaged-media-e2e.mjs",
    "test:whisper-worker": "electron tests/integration/whisper-worker-host.cjs && node scripts/build-whisper-client-harness.mjs && electron tmp/tests/whisper-client-real-host.cjs",
    "test:whisper-real": "pnpm build && node scripts/build-whisper-real-harness.mjs && electron tmp/tests/whisper-real-host.cjs",
    "notices": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check",
    "model-manifest": "node scripts/model-manifest.mjs --write",
    "model-manifest:check": "node scripts/model-manifest.mjs --check",
    "model-manifest:verify-live": "node scripts/model-manifest.mjs --verify-live",
    "network:boundary": "node scripts/network-boundary-policy.mjs",
    "network:capture:status": "node scripts/os-packet-capture.mjs --status",
    "security:dependencies": "node scripts/audit-node-production.mjs && node scripts/audit-rust.mjs",
    "security:history": "node scripts/secret-history-scan.mjs",
    "security:static": "pnpm network:boundary && vitest run tests/unit/network-boundary.test.ts tests/unit/package-policy.test.ts tests/unit/security-tooling.test.ts tests/security",
    "security:gate": "pnpm security:static && pnpm security:dependencies && pnpm security:history",
    "security:release-gate": "pnpm install --frozen-lockfile && pnpm security:gate",
    "audio-fixture:check": "node scripts/generate-audio-fixture.mjs --check",
    "test:helper": "cargo test --manifest-path helper/Cargo.toml --locked",
    "test:helper:harness": "node tests/native/helper-harness.mjs",
    "test:helper:manual": "node tests/native/helper-harness.mjs --interactive",
    "lint:helper": "cargo clippy --manifest-path helper/Cargo.toml --locked --all-targets -- -D warnings",
    "format:helper": "cargo fmt --manifest-path helper/Cargo.toml --all -- --check",
    "dead-code": "knip --config knip.json",
    "release:audit": "node scripts/release-audit.mjs && node scripts/reference-independence.mjs",
    "release:assemble": "node scripts/assemble-release.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "release:verify-draft": "node scripts/verify-draft-release.mjs",
    "release:verify-tag": "node scripts/verify-release-tag.mjs",
    "rust:fetch-targets": "node scripts/fetch-rust-targets.mjs",
    "boundaries": "node scripts/verify-boundaries.mjs",
    "package:inspect": "node scripts/inspect-package.mjs",
    "artifact-provenance:verify": "node scripts/artifact-provenance.mjs --verify",
    "package:win": "node scripts/run-package.mjs win",
    "package:win:arm64": "node scripts/run-package.mjs win-arm64",
    "package:win:dir": "node scripts/run-package.mjs win-dir",
    "package:unsigned:win": "node scripts/run-package.mjs win-unsigned",
    "package:unsigned:win:arm64": "node scripts/run-package.mjs win-arm64-unsigned",
    "package:unsigned:mac:x64": "node scripts/run-package.mjs mac-x64-unsigned",
    "package:unsigned:mac:arm64": "node scripts/run-package.mjs mac-arm64-unsigned",
    "package:mac": "pnpm package:mac:x64 && pnpm package:mac:arm64",
    "package:mac:x64": "node scripts/run-package.mjs mac-x64",
    "package:mac:arm64": "node scripts/run-package.mjs mac-arm64",
    "performance:packaged": "node scripts/measure-packaged-performance.mjs",
    "validate": "pnpm release:audit && pnpm dead-code && pnpm notices:check && pnpm model-manifest:check && pnpm audio-fixture:check && pnpm network:boundary && pnpm format:check && pnpm format:helper && pnpm lint && pnpm lint:helper && pnpm typecheck && pnpm test && pnpm test:helper && pnpm build",
    "validate:unsigned-release": "node scripts/release-audit.mjs && pnpm dead-code && pnpm notices:check && pnpm model-manifest:check && pnpm audio-fixture:check && pnpm network:boundary && pnpm format:check && pnpm format:helper && pnpm lint && pnpm lint:helper && pnpm typecheck && pnpm test && pnpm test:helper && pnpm build"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@axe-core/playwright": "4.12.1",
    "@electron/asar": "4.2.0",
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "1.3.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@swc/core": "1.15.46",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/aws4": "1.11.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/write-file-atomic": "4.0.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "aws4": "1.13.2",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "js-yaml": "4.1.1",
    "jsdom": "29.1.1",
    "knip": "5.83.0",
    "prettier": "3.9.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "write-file-atomic": "8.0.0"
  }
}
